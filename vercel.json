{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pt-br",
      "destination": "/index"
    },
    {
      "source": "/pt-pt",
      "destination": "/index"
    },
    {
      "source": "/en",
      "destination": "/index"
    },
    {
      "source": "/es",
      "destination": "/index"
    },
    {
      "source": "/fr",
      "destination": "/index"
    },
    {
      "source": "/de",
      "destination": "/index"
    },
    {
      "source": "/it",
      "destination": "/index"
    },
    {
      "source": "/nl",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}